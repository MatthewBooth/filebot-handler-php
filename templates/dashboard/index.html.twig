{% extends 'base.html.twig' %}

{% block title %}Dashboard · FileBot Handler{% endblock %}

{% block body %}
    <nav class="navbar navbar-dark app-navbar">
        <div class="container-fluid dashboard-content px-3 px-lg-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="{{ path('app_dashboard') }}">
                <span class="brand-mark"><img src="{{ asset('favicon.png') }}" alt=""></span>
                <span>FileBot Handler</span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <a class="btn btn-sm btn-outline-light" href="{{ path('app_dashboard') }}">Refresh</a>
                <a class="btn btn-sm btn-outline-light" href="{{ path('app.swagger_ui') }}">API docs</a>
            </div>
        </div>
    </nav>

    <main class="container-fluid dashboard-content px-3 px-lg-4 py-4 py-lg-5">
        <header class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <div>
                <p class="eyebrow mb-2">Media automation</p>
                <h1 class="display-6 fw-bold mb-2">Job queue</h1>
                <p class="text-secondary mb-0">Live queue activity and recent FileBot job history.</p>
            </div>
            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createJobModal">
                Create job
            </button>
        </header>

        <div
            data-controller="dashboard-refresh"
            data-dashboard-refresh-url-value="{{ path('app_dashboard_live', {page: app.request.query.get('page', 1)}) }}"
            data-dashboard-refresh-interval-value="10000"
        >
            <p class="small text-secondary mb-3" role="status" aria-live="polite" data-dashboard-refresh-target="status">
                Queue information refreshes automatically every 10 seconds.
            </p>
            <div data-dashboard-refresh-target="content">
                {% include 'dashboard/_live_content.html.twig' %}
            </div>
        </div>

        <div class="modal fade" id="createJobModal" tabindex="-1" aria-labelledby="createJobModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header">
                        <div>
                            <p class="eyebrow mb-1">New queue item</p>
                            <h2 class="modal-title h5 fw-bold" id="createJobModalTitle">Create a FileBot job</h2>
                        </div>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="{{ path('app_api_filebotjob_create') }}" method="post" data-controller="job-form" data-action="submit->job-form#submit">
                        <div class="modal-body">
                            <div class="alert alert-danger d-none" role="alert" data-job-form-target="feedback"></div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="create-job-path">Media path</label>
                                <input class="form-control" id="create-job-path" name="path" type="text" value="/torrents/" placeholder="/torrents/Example.Movie.2024" required>
                                <div class="form-text">Enter an absolute path visible to the API and worker containers.</div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="create-job-label">Media type</label>
                                    <select class="form-select" id="create-job-label" name="label" required>
                                        <option value="movie">Movie</option>
                                        <option value="tv">TV</option>
                                        <option value="anime">Anime</option>
                                        <option value="music">Music</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="create-job-action">File action</label>
                                    <select class="form-select" id="create-job-action" name="action" required>
                                        <option value="test">Test only</option>
                                        <option value="copy" selected>Copy</option>
                                        <option value="move">Move</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="create-job-conflict">Conflict policy</label>
                                    <select class="form-select" id="create-job-conflict" name="conflict" required>
                                        <option value="skip" selected>Skip</option>
                                        <option value="replace">Replace</option>
                                        <option value="auto">Automatic</option>
                                        <option value="index">Index</option>
                                        <option value="fail">Fail</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="create-job-order">Episode order</label>
                                    <select class="form-select" id="create-job-order" name="order" required>
                                        <option value="Airdate" selected>Airdate</option>
                                        <option value="DVD">DVD</option>
                                        <option value="Absolute">Absolute</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold" for="create-job-media-id">Media database ID <span class="text-secondary fw-normal">(optional)</span></label>
                                    <input class="form-control" id="create-job-media-id" name="mediaId" type="number" min="1" step="1" inputmode="numeric">
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-4 mt-4">
                                <div class="form-check">
                                    <input class="form-check-input" id="create-job-artwork" name="artwork" type="checkbox" checked>
                                    <label class="form-check-label" for="create-job-artwork">Fetch artwork</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" id="create-job-strict" name="strict" type="checkbox">
                                    <label class="form-check-label" for="create-job-strict">Strict matching</label>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-light border" type="button" data-bs-dismiss="modal">Cancel</button>
                            <button class="btn btn-primary" type="submit" data-job-form-target="submit">Queue job</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
