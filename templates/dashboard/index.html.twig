{% extends 'base.html.twig' %}

{% block title %}Dashboard · FileBot Handler{% endblock %}

{% block body %}
    <nav class="navbar navbar-dark app-navbar">
        <div class="container-fluid dashboard-content px-3 px-lg-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="{{ path('app_dashboard') }}">
                <span class="brand-mark">F</span>
                <span>FileBot Handler</span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <a class="btn btn-sm btn-outline-light" href="{{ path('app_dashboard') }}">Refresh</a>
                <a class="btn btn-sm btn-outline-light" href="{{ path('app.swagger_ui') }}">API docs</a>
            </div>
        </div>
    </nav>

    <main class="container-fluid dashboard-content px-3 px-lg-4 py-4 py-lg-5">
        <header class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <div>
                <p class="eyebrow mb-2">Media automation</p>
                <h1 class="display-6 fw-bold mb-2">Job queue</h1>
                <p class="text-secondary mb-0">Queued and processing FileBot jobs.</p>
            </div>
            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createJobModal">
                Create job
            </button>
        </header>

        {% if not queueAvailable %}
            <div class="alert alert-danger mb-4" role="alert">
                The job queue is unavailable right now. Please try refreshing in a moment.
            </div>
        {% endif %}

        <section aria-label="Queue summary" class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
            <div class="col">
                <article class="card metric-card h-100">
                    <div class="card-body p-4">
                        <p class="eyebrow mb-3">Queued</p>
                        <div class="metric-value" id="queued-count">{{ queuedCount ?? '—' }}</div>
                        <p class="small text-secondary mb-0 mt-2">Waiting for a worker</p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="card metric-card h-100">
                    <div class="card-body p-4">
                        <p class="eyebrow mb-3">Processing</p>
                        <div class="metric-value" id="processing-count">{{ processingCount ?? '—' }}</div>
                        <p class="small text-secondary mb-0 mt-2">Currently handled by a worker</p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="card metric-card h-100">
                    <div class="card-body p-4">
                        <p class="eyebrow mb-3">Visible jobs</p>
                        <div class="metric-value" id="total-count">{{ queueAvailable ? jobs|length : '—' }}</div>
                        <p class="small text-secondary mb-0 mt-2">Up to 500 jobs from the queue</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="card content-card overflow-hidden" aria-labelledby="recent-jobs-title" data-controller="job-list">
            <div class="alert alert-danger rounded-0 border-0 mb-0 d-none" role="alert" data-job-list-target="feedback"></div>
            <div class="card-header bg-white border-0 px-4 pt-4 pb-3 d-flex flex-column flex-sm-row justify-content-between gap-2">
                <div>
                    <h2 id="recent-jobs-title" class="h5 fw-bold mb-1">Jobs</h2>
                    <p class="small text-secondary mb-0">Live status and submitted job settings.</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-jobs mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Job</th>
                            <th scope="col">Type</th>
                            <th scope="col">Status</th>
                            <th scope="col">Action</th>
                            <th scope="col"><span class="visually-hidden">Details</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if not queueAvailable %}
                            <tr><td colspan="6" class="text-center text-secondary py-5">Queue data could not be loaded.</td></tr>
                        {% elseif jobs is empty %}
                            <tr><td colspan="6" class="text-center text-secondary py-5">There are no queued or processing jobs.</td></tr>
                        {% else %}
                            {% for job in jobs %}
                                {% set labelTone = {
                                    movie: 'primary',
                                    tv: 'success',
                                    anime: 'warning',
                                    music: 'info'
                                }[job.message.label] ?? 'secondary' %}
                                <tr data-job-id="{{ job.id }}">
                                    <td><code>{{ job.id }}</code></td>
                                    <td>
                                        <div class="fw-semibold text-truncate" title="{{ job.message.path }}">
                                            {{ job.message.path|trim('/')|split('/')|last }}
                                        </div>
                                        <div class="small text-secondary text-truncate" title="{{ job.message.path }}">
                                            {{ job.message.path }}
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill text-bg-{{ labelTone }}-subtle text-{{ labelTone }}-emphasis">
                                            {{ job.message.label|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if job.status == 'processing' %}
                                            <span class="badge rounded-pill text-bg-info-subtle text-info-emphasis">Processing</span>
                                            {% if job.worker is defined %}
                                                <div class="small text-secondary mt-1">{{ job.worker }}</div>
                                            {% endif %}
                                            {% if job.deliveryCount is defined %}
                                                <div class="small text-secondary">Delivery {{ job.deliveryCount }}</div>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge rounded-pill text-bg-secondary-subtle text-secondary-emphasis">Queued</span>
                                        {% endif %}
                                    </td>
                                    <td><span class="badge text-bg-light border text-dark">{{ job.message.action|capitalize }}</span></td>
                                    <td class="text-end">
                                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_api_filebotjob_show', {id: job.id}) }}">
                                            View JSON
                                        </a>
                                            {% if job.status == 'queued' %}
                                                <button
                                                    class="btn btn-sm btn-outline-danger ms-1"
                                                    type="button"
                                                    data-action="job-list#delete"
                                                    data-job-id="{{ job.id }}"
                                                    data-url="{{ path('app_api_filebotjob_delete', {id: job.id}) }}"
                                                >Delete</button>
                                            {% else %}
                                                <span class="small text-secondary ms-1">In progress</span>
                                            {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-0 px-4 py-3">
                <span class="small text-secondary">
                    {% if queueAvailable %}Showing {{ jobs|length }} job{{ jobs|length == 1 ? '' : 's' }}{% else %}Queue unavailable{% endif %}
                </span>
            </div>
        </section>

        <div class="modal fade" id="createJobModal" tabindex="-1" aria-labelledby="createJobModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header">
                        <div>
                            <p class="eyebrow mb-1">New queue item</p>
                            <h2 class="modal-title h5 fw-bold" id="createJobModalTitle">Create a FileBot job</h2>
                        </div>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="{{ path('app_api_filebotjob_create') }}" method="post" data-controller="job-form" data-action="submit->job-form#submit">
                        <div class="modal-body">
                            <div class="alert alert-danger d-none" role="alert" data-job-form-target="feedback"></div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="create-job-path">Media path</label>
                                <input class="form-control" id="create-job-path" name="path" type="text" placeholder="/torrents/Example.Movie.2024" required>
                                <div class="form-text">Enter an absolute path visible to the API and worker containers.</div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="create-job-label">Media type</label>
                                    <select class="form-select" id="create-job-label" name="label" required>
                                        <option value="movie">Movie</option>
                                        <option value="tv">TV</option>
                                        <option value="anime">Anime</option>
                                        <option value="music">Music</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="create-job-action">File action</label>
                                    <select class="form-select" id="create-job-action" name="action" required>
                                        <option value="test">Test only</option>
                                        <option value="copy" selected>Copy</option>
                                        <option value="move">Move</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="create-job-conflict">Conflict policy</label>
                                    <select class="form-select" id="create-job-conflict" name="conflict" required>
                                        <option value="skip" selected>Skip</option>
                                        <option value="replace">Replace</option>
                                        <option value="auto">Automatic</option>
                                        <option value="index">Index</option>
                                        <option value="fail">Fail</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" for="create-job-order">Episode order</label>
                                    <select class="form-select" id="create-job-order" name="order" required>
                                        <option value="Airdate" selected>Airdate</option>
                                        <option value="DVD">DVD</option>
                                        <option value="Absolute">Absolute</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold" for="create-job-media-id">Media database ID <span class="text-secondary fw-normal">(optional)</span></label>
                                    <input class="form-control" id="create-job-media-id" name="mediaId" type="number" min="1" step="1" inputmode="numeric">
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-4 mt-4">
                                <div class="form-check">
                                    <input class="form-check-input" id="create-job-artwork" name="artwork" type="checkbox" checked>
                                    <label class="form-check-label" for="create-job-artwork">Fetch artwork</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" id="create-job-strict" name="strict" type="checkbox">
                                    <label class="form-check-label" for="create-job-strict">Strict matching</label>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-light border" type="button" data-bs-dismiss="modal">Cancel</button>
                            <button class="btn btn-primary" type="submit" data-job-form-target="submit">Queue job</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
