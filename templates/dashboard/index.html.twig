{% extends 'base.html.twig' %}

{% block title %}Dashboard · FileBot Handler{% endblock %}

{% block body %}
    <nav class="navbar navbar-dark app-navbar">
        <div class="container-fluid dashboard-content px-3 px-lg-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="{{ path('app_dashboard') }}">
                <span class="brand-mark">F</span>
                <span>FileBot Handler</span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <a class="btn btn-sm btn-outline-light" href="{{ path('app_dashboard') }}">Refresh</a>
                <a class="btn btn-sm btn-outline-light" href="{{ path('app.swagger_ui') }}">API docs</a>
            </div>
        </div>
    </nav>

    <main class="container-fluid dashboard-content px-3 px-lg-4 py-4 py-lg-5">
        <header class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
            <div>
                <p class="eyebrow mb-2">Media automation</p>
                <h1 class="display-6 fw-bold mb-2">Job queue</h1>
                <p class="text-secondary mb-0">Queued and processing FileBot jobs.</p>
            </div>
        </header>

        {% if not queueAvailable %}
            <div class="alert alert-danger mb-4" role="alert">
                The job queue is unavailable right now. Please try refreshing in a moment.
            </div>
        {% endif %}

        <section aria-label="Queue summary" class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
            <div class="col">
                <article class="card metric-card h-100">
                    <div class="card-body p-4">
                        <p class="eyebrow mb-3">Queued</p>
                        <div class="metric-value" id="queued-count">{{ queuedCount ?? '—' }}</div>
                        <p class="small text-secondary mb-0 mt-2">Waiting for a worker</p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="card metric-card h-100">
                    <div class="card-body p-4">
                        <p class="eyebrow mb-3">Processing</p>
                        <div class="metric-value" id="processing-count">{{ processingCount ?? '—' }}</div>
                        <p class="small text-secondary mb-0 mt-2">Currently handled by a worker</p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="card metric-card h-100">
                    <div class="card-body p-4">
                        <p class="eyebrow mb-3">Visible jobs</p>
                        <div class="metric-value" id="total-count">{{ queueAvailable ? jobs|length : '—' }}</div>
                        <p class="small text-secondary mb-0 mt-2">Up to 500 jobs from the queue</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="card content-card overflow-hidden" aria-labelledby="recent-jobs-title">
            <div class="card-header bg-white border-0 px-4 pt-4 pb-3 d-flex flex-column flex-sm-row justify-content-between gap-2">
                <div>
                    <h2 id="recent-jobs-title" class="h5 fw-bold mb-1">Jobs</h2>
                    <p class="small text-secondary mb-0">Live status and submitted job settings.</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-jobs mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Job</th>
                            <th scope="col">Type</th>
                            <th scope="col">Status</th>
                            <th scope="col">Action</th>
                            <th scope="col"><span class="visually-hidden">Details</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if not queueAvailable %}
                            <tr><td colspan="6" class="text-center text-secondary py-5">Queue data could not be loaded.</td></tr>
                        {% elseif jobs is empty %}
                            <tr><td colspan="6" class="text-center text-secondary py-5">There are no queued or processing jobs.</td></tr>
                        {% else %}
                            {% for job in jobs %}
                                {% set labelTone = {
                                    movie: 'primary',
                                    tv: 'success',
                                    anime: 'warning',
                                    music: 'info'
                                }[job.message.label] ?? 'secondary' %}
                                <tr data-job-id="{{ job.id }}">
                                    <td><code>{{ job.id }}</code></td>
                                    <td>
                                        <div class="fw-semibold text-truncate" title="{{ job.message.path }}">
                                            {{ job.message.path|trim('/')|split('/')|last }}
                                        </div>
                                        <div class="small text-secondary text-truncate" title="{{ job.message.path }}">
                                            {{ job.message.path }}
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill text-bg-{{ labelTone }}-subtle text-{{ labelTone }}-emphasis">
                                            {{ job.message.label|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if job.status == 'processing' %}
                                            <span class="badge rounded-pill text-bg-info-subtle text-info-emphasis">Processing</span>
                                            {% if job.worker is defined %}
                                                <div class="small text-secondary mt-1">{{ job.worker }}</div>
                                            {% endif %}
                                            {% if job.deliveryCount is defined %}
                                                <div class="small text-secondary">Delivery {{ job.deliveryCount }}</div>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge rounded-pill text-bg-secondary-subtle text-secondary-emphasis">Queued</span>
                                        {% endif %}
                                    </td>
                                    <td><span class="badge text-bg-light border text-dark">{{ job.message.action|capitalize }}</span></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_api_filebotjob_show', {id: job.id}) }}">
                                            View JSON
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-0 px-4 py-3">
                <span class="small text-secondary">
                    {% if queueAvailable %}Showing {{ jobs|length }} job{{ jobs|length == 1 ? '' : 's' }}{% else %}Queue unavailable{% endif %}
                </span>
            </div>
        </section>
    </main>
{% endblock %}
