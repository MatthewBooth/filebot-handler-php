<div data-dashboard-refresh-fragment>
{% if not queueAvailable %}
    <div class="alert alert-danger mb-4" role="alert">
        The job queue is unavailable right now. Please try refreshing in a moment.
    </div>
{% endif %}

<section aria-label="Queue summary" class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <div class="col">
        <article class="card metric-card h-100">
            <div class="card-body p-4">
                <p class="eyebrow mb-3">Queued</p>
                <div class="metric-value" id="queued-count">{{ queuedCount ?? '—' }}</div>
                <p class="small text-secondary mb-0 mt-2">Waiting for a worker</p>
            </div>
        </article>
    </div>
    <div class="col">
        <article class="card metric-card h-100">
            <div class="card-body p-4">
                <p class="eyebrow mb-3">Processing</p>
                <div class="metric-value" id="processing-count">{{ processingCount ?? '—' }}</div>
                <p class="small text-secondary mb-0 mt-2">Currently handled by a worker</p>
            </div>
        </article>
    </div>
    <div class="col">
        <article class="card metric-card h-100">
            <div class="card-body p-4">
                <p class="eyebrow mb-3">Visible jobs</p>
                <div class="metric-value" id="total-count">{{ queueAvailable ? jobs|length : '—' }}</div>
                <p class="small text-secondary mb-0 mt-2">Up to 500 jobs from the queue</p>
            </div>
        </article>
    </div>
</section>

<section class="card content-card overflow-hidden" aria-labelledby="recent-jobs-title" data-controller="job-list">
    <div class="alert alert-danger rounded-0 border-0 mb-0 d-none" role="alert" data-job-list-target="feedback"></div>
    <div class="card-header bg-white border-0 px-4 pt-4 pb-3 d-flex flex-column flex-sm-row justify-content-between gap-2">
        <div>
            <h2 id="recent-jobs-title" class="h5 fw-bold mb-1">Jobs</h2>
            <p class="small text-secondary mb-0">Live status and submitted job settings.</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-jobs mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Job</th>
                    <th scope="col">Type</th>
                    <th scope="col">Worker</th>
                    <th scope="col">Status</th>
                    <th scope="col">Action</th>
                    <th scope="col"><span class="visually-hidden">Details</span></th>
                </tr>
            </thead>
            <tbody>
                {% if not queueAvailable %}
                    <tr><td colspan="6" class="text-center text-secondary py-5">Queue data could not be loaded.</td></tr>
                {% elseif jobs is empty %}
                    <tr><td colspan="6" class="text-center text-secondary py-5">There are no queued or processing jobs.</td></tr>
                {% else %}
                    {% for job in jobs %}
                        {% set labelTone = {
                            movie: 'primary',
                            tv: 'success',
                            anime: 'warning',
                            music: 'info'
                        }[job.message.label] ?? 'secondary' %}
                        <tr data-job-id="{{ job.id }}">
                            <td>
                                <div class="fw-semibold text-truncate" title="{{ job.message.path }}">
                                    {{ job.message.path|trim('/')|split('/')|last }}
                                </div>
                                <div class="small text-secondary text-truncate" title="{{ job.message.path }}">
                                    {{ job.message.path }}
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill text-bg-{{ labelTone }}-subtle text-{{ labelTone }}-emphasis">
                                    {{ job.message.label|capitalize }}
                                </span>
                            </td>
                            <td class="small text-secondary">{{ job.worker ?? '—' }}</td>
                            <td>
                                {% if job.status == 'processing' %}
                                    <span class="badge rounded-pill text-bg-info-subtle text-info-emphasis">Processing</span>
                                {% else %}
                                    <span class="badge rounded-pill text-bg-secondary-subtle text-secondary-emphasis">Queued</span>
                                {% endif %}
                            </td>
                            <td><span class="badge text-bg-light border text-dark">{{ job.message.action|capitalize }}</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <a class="btn btn-sm btn-outline-secondary px-3" href="{{ path('app_api_filebotjob_show', {id: job.id}) }}">JSON</a>
                                    {% if job.status == 'queued' %}
                                        <button
                                            class="btn btn-sm btn-outline-danger px-3"
                                            type="button"
                                            data-action="job-list#delete"
                                            data-job-id="{{ job.id }}"
                                            data-url="{{ path('app_api_filebotjob_delete', {id: job.id}) }}"
                                        >Delete</button>
                                    {% else %}
                                        <span class="small text-secondary">In progress</span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white border-0 px-4 py-3">
        <span class="small text-secondary">
            {% if queueAvailable %}Showing {{ jobs|length }} job{{ jobs|length == 1 ? '' : 's' }}{% else %}Queue unavailable{% endif %}
        </span>
    </div>
</section>

<section class="card content-card overflow-hidden mt-4" aria-labelledby="job-history-title">
    <div class="card-header bg-white border-0 px-4 pt-4 pb-3">
        <h2 id="job-history-title" class="h5 fw-bold mb-1">Recent job history</h2>
        <p class="small text-secondary mb-0">{{ historyCount }} finished jobs from the last 7 days.</p>
    </div>
    {% if not historyAvailable %}
        <div class="alert alert-warning rounded-0 border-0 mb-0" role="status">
            Job history is temporarily unavailable.
        </div>
    {% elseif historyJobs is empty %}
        <div class="px-4 pb-4 small text-secondary">No finished jobs in the last 7 days.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover table-jobs mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Finished</th>
                        <th scope="col">Job</th>
                        <th scope="col">Type</th>
                        <th scope="col">Status</th>
                        <th scope="col">Details</th>
                    </tr>
                </thead>
                <tbody>
                    {% for historyJob in historyJobs %}
                        {% set historyTone = {
                            completed: 'success',
                            skipped: 'warning',
                            failed: 'danger',
                            deleted: 'secondary'
                        }[historyJob.status] ?? 'secondary' %}
                        <tr>
                            <td class="text-nowrap">{{ historyJob.finishedAt|date('j M Y, g:i a') }}</td>
                            <td>
                                <div class="fw-semibold text-truncate" title="{{ historyJob.message.path }}">
                                    {{ historyJob.message.path|trim('/')|split('/')|last }}
                                </div>
                                <div class="small text-secondary text-truncate" title="{{ historyJob.message.path }}">
                                    {{ historyJob.message.path }}
                                </div>
                            </td>
                            <td>{{ historyJob.message.label|capitalize }}</td>
                            <td><span class="badge text-bg-{{ historyTone }}">{{ historyJob.status|capitalize }}</span></td>
                            <td>
                                {% if historyJob.status == 'failed' %}
                                    <span class="small text-danger">{{ historyJob.error ?? 'Job failed without an error message.' }}</span>
                                {% elseif historyJob.status == 'skipped' %}
                                    <span class="small text-secondary">{{ historyJob.reason ?? 'Job was skipped.' }}</span>
                                {% elseif historyJob.worker is defined and historyJob.worker is not null %}
                                    <span class="small text-secondary">Worker {{ historyJob.worker }}</span>
                                {% else %}
                                    <span class="small text-secondary">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if historyPageCount > 1 %}
            <nav class="card-footer bg-white border-0 px-4 py-3" aria-label="Job history pages">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    <li class="page-item{% if historyPage == 1 %} disabled{% endif %}">
                        <a class="page-link" href="{{ path('app_dashboard', {page: historyPage - 1}) }}"{% if historyPage == 1 %} aria-disabled="true" tabindex="-1"{% endif %}>Previous</a>
                    </li>
                    {% for pageNumber in 1..historyPageCount %}
                        <li class="page-item{% if pageNumber == historyPage %} active{% endif %}">
                            <a class="page-link" href="{{ path('app_dashboard', {page: pageNumber}) }}"{% if pageNumber == historyPage %} aria-current="page"{% endif %}>{{ pageNumber }}</a>
                        </li>
                    {% endfor %}
                    <li class="page-item{% if historyPage == historyPageCount %} disabled{% endif %}">
                        <a class="page-link" href="{{ path('app_dashboard', {page: historyPage + 1}) }}"{% if historyPage == historyPageCount %} aria-disabled="true" tabindex="-1"{% endif %}>Next</a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    {% endif %}
</section>
</div>
